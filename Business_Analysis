-- ANALYSING BUSINESS QUESTIONS (Final Projects)
-- What are the top 10 products by revenue?
SELECT
p.Product_ID,
p.Product_Name,
p.Product_Category,
SUM(s.units*p.product_price) AS Total_Revenue
FROM sales As s
JOIN products AS p
ON s.Product_ID = p. Product_ID

GROUP BY p.Product_ID,
		 p.Product_Name,
         p.Product_Category
ORDER BY Total_Revenue DESC
LIMIT 10;

-- What are the top 10 products by profit?
SELECT
p.Product_ID,
p.Product_Name,
p.Product_Category,
SUM(s.Units) AS total_units_sold,
SUM(s.Units * (p.Product_Price - p.Product_Cost)) AS Total_Profit
FROM sales As s
JOIN products AS p
ON s.Product_ID = p. Product_ID

GROUP BY p.Product_ID,
		 p.Product_Name,
         p.Product_Category
ORDER BY Total_Profit DESC
LIMIT 10;

-- Which categories generate the most revenue?
SELECT
p.Product_Category,
SUM(s.units*p.product_price) AS Total_Revenue
FROM sales As s
JOIN products AS p
ON s.Product_ID = p. Product_ID
GROUP BY p.Product_Category
ORDER BY Total_Revenue DESC;

-- Which stores generate the most revenue?
SELECT
st.Store_ID,
st.Store_Name,
st.Store_location,
SUM(s.units*p.product_price) AS Total_Revenue
FROM sales As s
JOIN products AS p
ON s.Product_ID = p. Product_ID
JOIN stores AS st
ON s.Store_ID = st.Store_ID
GROUP BY st.Store_ID,
		 st.Store_Name,
         st.Store_location
ORDER BY Total_Revenue DESC
LIMIT 10;

-- Which cities generate the most revenue?
SELECT
st.Store_City,
SUM(s.units*p.product_price) AS Total_Revenue
FROM sales As s
JOIN products AS p
ON s.Product_ID = p. Product_ID
JOIN stores AS st
ON s.Store_ID = st.Store_ID
GROUP BY st.Store_City
ORDER BY Total_Revenue DESC
LIMIT 10;

-- Which months/periods generate the highest revenue?
SELECT
    YEAR(s.Date) AS Sales_Year,
    MONTH(s.Date) AS Month_Number,
    MONTHNAME(s.Date) AS Sales_Month,
    SUM(s.Units * p.Product_Price) AS Total_Revenue
FROM Sales s
JOIN Products p
    ON s.Product_ID = p.Product_ID
GROUP BY
    YEAR(s.Date),
    MONTH(s.Date),
    MONTHNAME(s.Date)
ORDER BY Total_Revenue DESC;
-- Are sales concentrated in a small number of products?
WITH Product_Sales AS (
    SELECT
        p.Product_ID,
        p.Product_Name,
        SUM(s.Units) AS Total_Units_Sold
    FROM Sales s
    JOIN Products p
        ON s.Product_ID = p.Product_ID
    GROUP BY
        p.Product_ID,
        p.Product_Name
),
Ranked_Products AS (
    SELECT
        Product_ID,
        Product_Name,
        Total_Units_Sold,
        SUM(Total_Units_Sold) OVER () AS Overall_Units_Sold,
        ROUND(
            Total_Units_Sold / SUM(Total_Units_Sold) OVER () * 100,
            2
        ) AS Sales_Percentage
    FROM Product_Sales
)
SELECT
    Product_ID,
    Product_Name,
    Total_Units_Sold,
    Sales_Percentage
FROM Ranked_Products
ORDER BY Total_Units_Sold DESC;
-- Which products are at risk of stockouts?
SELECT
    p.Product_ID,
    p.Product_Name,
    p.Product_Category,
    SUM(i.Stock_On_Hand) AS Total_Inventory
FROM Inventory i
JOIN Products p
    ON i.Product_ID = p.Product_ID
GROUP BY
    p.Product_ID,
    p.Product_Name,
    p.Product_Category
HAVING SUM(i.Stock_On_Hand) <= 5
ORDER BY Total_Inventory ASC;

-- Which products are potentially overstocked?
WITH Inventory_Total AS (
    SELECT
        Product_ID,
        SUM(Stock_On_Hand) AS Total_Inventory
    FROM Inventory
    GROUP BY Product_ID
),

Sales_Total AS (
    SELECT
        Product_ID,
        SUM(Units) AS Total_Units_Sold
    FROM Sales
    GROUP BY Product_ID
),

Product_Performance AS (
    SELECT
        p.Product_ID,
        p.Product_Name,
        p.Product_Category,
        COALESCE(i.Total_Inventory, 0) AS Total_Inventory,
        COALESCE(s.Total_Units_Sold, 0) AS Total_Units_Sold
    FROM Products p
    LEFT JOIN Inventory_Total i
        ON p.Product_ID = i.Product_ID
    LEFT JOIN Sales_Total s
        ON p.Product_ID = s.Product_ID
)

SELECT
    Product_ID,
    Product_Name,
    Product_Category,
    Total_Inventory,
    Total_Units_Sold
FROM Product_Performance
WHERE Total_Inventory > (
    SELECT AVG(Total_Inventory)
    FROM Product_Performance
)
AND Total_Units_Sold < (
    SELECT AVG(Total_Units_Sold)
    FROM Product_Performance
)
ORDER BY Total_Inventory DESC;

-- Which stores are performing below average?
WITH Store_Performance AS (
    SELECT
        st.Store_ID,
        st.Store_Name,
        st.Store_City,
        SUM(s.Units * p.Product_Price) AS Total_Revenue
    FROM Sales s
    JOIN Stores st
        ON s.Store_ID = st.Store_ID
    JOIN Products p
        ON s.Product_ID = p.Product_ID
    GROUP BY
        st.Store_ID,
        st.Store_Name,
        st.Store_City
)

SELECT
    Store_ID,
    Store_Name,
    Store_City,
    Total_Revenue
FROM Store_Performance
WHERE Total_Revenue < (
    SELECT AVG(Total_Revenue)
    FROM Store_Performance
)
ORDER BY Total_Revenue ASC;

-- Which products have high sales but low profit margins?
WITH Product_Performance AS (
    SELECT
        p.Product_ID,
        p.Product_Name,
        p.Product_Category,
        SUM(s.Units) AS Total_Units_Sold,
        ROUND(
            ((p.Product_Price - p.Product_Cost) / p.Product_Price) * 100,
            2
        ) AS Profit_Margin
    FROM Sales s
    JOIN Products p
        ON s.Product_ID = p.Product_ID
    GROUP BY
        p.Product_ID,
        p.Product_Name,
        p.Product_Category,
        p.Product_Price,
        p.Product_Cost
)
SELECT
    Product_ID,
    Product_Name,
    Product_Category,
    Total_Units_Sold,
    Profit_Margin
FROM Product_Performance
WHERE Total_Units_Sold > (
    SELECT AVG(Total_Units_Sold)
    FROM Product_Performance
)
AND Profit_Margin < (
    SELECT AVG(Profit_Margin)
    FROM Product_Performance
)
ORDER BY Total_Units_Sold DESC;


